{
  "name": "personal-blog",
  "version": "1.0.0",
  "description": "Personal blog with Vue 3 + Vite",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:cms": "npx decap-server",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:cms\"",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "test": "npm run test --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "decap-server": "^3.4.0"
  }
}