# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/personal_blog
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_blog
DB_USER=user
DB_PASSWORD=password

# Server Configuration
PORT=3001
NODE_ENV=development

# Admin Panel Configuration (Generate a random string for security)
ADMIN_PATH=manage-panel-[RANDOM_STRING_HERE]

# Cloud Storage Configuration (AWS S3 / Aliyun OSS / Tencent COS)
# For AWS S3:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your-bucket-name

# For Aliyun OSS:
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=your_access_key
# OSS_ACCESS_KEY_SECRET=your_secret_key
# OSS_BUCKET=your-bucket-name

# CDN Configuration (Optional)
CDN_DOMAIN=https://cdn.yourdomain.com

# CORS Configuration
FRONTEND_URL=http://localhost:3000
