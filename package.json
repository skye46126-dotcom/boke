{
  "name": "personal-blog",
  "version": "1.0.0",
  "description": "Personal blog with Vue 3 + Vite",
  "private": true,
  "workspaces": [
    "frontend-vue"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend-vue",
    "dev:api": "node server/index.mjs",
    "dev:cms": "npx decap-server",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\" \"npm run dev:cms\"",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "dev:pages": "npx wrangler pages dev frontend-vue/dist --compatibility-date=2026-04-27",
    "build": "npm run build --workspace=frontend-vue",
    "deploy:pages": "npm run build && npx wrangler pages deploy frontend-vue/dist --project-name=boke-cd2",
    "start": "npm run start --workspace=frontend-vue",
    "test": "npm run test --workspace=frontend-vue",
    "smoke:content-hub": "node scripts/contentHubSmokeTest.mjs",
    "test:content-hub:agent-flow": "node scripts/contentHubAgentFlowTest.mjs",
    "test:content-hub": "npm run smoke:content-hub && npm run test:content-hub:agent-flow"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "decap-server": "^3.4.0"
  }
}
